<?xml version="1.0" encoding="utf-8"?>
<!-- Niente backup nel cloud e niente trasferimento da telefono a telefono
     (Android 12+): l'accesso salvato e' cifrato con una chiave del telefono
     e su un altro telefono non si leggerebbe (revisione 6/10/2026). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
